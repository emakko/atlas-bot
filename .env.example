# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: a server ID to sync slash commands to instantly while developing.
# Leave empty to sync globally (can take up to an hour to show up).
ATLAS_DEV_GUILD_ID=

# Optional overrides
ATLAS_DB_PATH=data/atlas.db
ATLAS_SOURCES_FILE=sources.yaml
ATLAS_POLL_MINUTES=15
